includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    parseModelCastsMethod: true
    databaseMigrationsPath:
        - database/migrations

    # The baseline is large; tolerate minor count drift between runs rather than
    # failing CI when an unrelated change shifts an inferred type.
    reportUnmatchedIgnoredErrors: false

    paths:
        - app
        - config
        - database
        - routes

    # Test files that live under app/ (PSR-4 namespace mismatches + a Pest guard
    # stub) — analysed via the test suite, not here.
    excludePaths:
        - app/*/Tests/*
        - app/**/Tests/*
        # Same intent, lowercase dir name: app/Actions/{Concerns,Decorators,Attributes}/tests
        - app/*/tests/*
        - app/**/tests/*

        # SecretsRestoreCommand (--version) and TaskRunCommand (--quiet) used to
        # be excluded here for triggering PHPStan *internal* errors. Both are
        # fixed — the options were renamed to --revision / --no-output — so the
        # exclusions are gone. Those reserved-global collisions were not merely
        # an analysis problem: they threw before handle() ran, so neither command
        # could be invoked at all.
        #
        # The old entries pointed at app/Console/Commands/ and
        # app/TaskRunner/Commands/; the modular-monolith refactor moved both
        # under app/Modules/, and because they were marked `(?)` (optional) they
        # silently stopped matching — which is why a full run aborted with
        # "Result is incomplete" and reported 0 errors.
        #
        # Optional Action concerns — opt-in markers, not composed into AsAction.
        - app/Actions/Concerns/AsABTestable.php
        - app/Actions/Concerns/AsFeatureFlagged.php
        - app/Actions/Concerns/WithAttributes.php

        # Edge action facade — workspace sections compose the leaf traits
        # directly; nothing uses this bundle today.
        - app/Livewire/Concerns/ManagesEdgeSite.php

        # Demo/example scripts that extend base classes which don't exist in the
        # codebase (BaseTask, EnhancedTask, Dply\Tasks\BaseTask) — non-runnable
        # samples. Paths corrected for the modular-monolith move: these used to
        # read app/TaskRunner/*, which stopped matching anything.
        - app/Modules/TaskRunner/Examples/*
        - app/Modules/TaskRunner/config/*

    # Existing violations are captured in phpstan-baseline.neon so the suite is
    # green today; new code is held to level 5. Regenerate the baseline
    # with: composer analyse:baseline
